{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/static/(.*)", "destination": "/api" },
    { "source": "/check", "destination": "/api" },
    { "source": "/check/(.*)", "destination": "/api" },
    { "source": "/scan/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/register_user", "destination": "/api" },
    { "source": "/list_users", "destination": "/api" },
    { "source": "/delete_user", "destination": "/api" },
    { "source": "/revoke_user", "destination": "/api" },
    { "source": "/report_crash", "destination": "/api" },
    { "source": "/upload_shift", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
